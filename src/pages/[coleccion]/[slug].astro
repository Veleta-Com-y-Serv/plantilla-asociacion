---
// Ficha de una actividad con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /actividades/<slug>/.
// Diseño «cercano»: banda verde claro con migas y hero partido (título con subrayado de acento, texto, chip de
// cuándo, botones; a la derecha la foto con esquinas de 1,1 rem o, sin foto, su icono en círculo grande); cuerpo con
// el `detalle` y, al lado, tabla de datos y caja verde de «Hazte socio»; franja de fotos (`imagenes`) y otras
// actividades como tarjetas con franja superior de color alterno, igual que en la portada.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const unirse = seccion('hazte-socio') ? '/#hazte-socio' : site.boton_cabecera?.url || '/#contacto';
const textoUnirse = site.boton_cabecera?.texto || 'Hazte socio';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre ${f.titulo}`);
const cuando = f.datos.find((d) => d.clave === 'cuando')?.valor ?? '';
const datos = f.datos.filter((d) => d.clave !== 'precio' && d.clave !== 'cuando');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion"><span class="subrayado">{f.titulo}</span></h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(cuando || f.precio) && (
            <p class="ficha-chips">
              {cuando && <span class="chip"><Icono nombre="calendario" tam={14} /> {cuando}</span>}
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={unirse}>{textoUnirse}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> Pregúntanos</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><span><Icono nombre={f.icono || 'montana'} tam={72} /></span></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio || cuando) && (
          <div class="tarjeta ficha-datos">
            <h2 class="ficha-lado-titulo">En pocas palabras</h2>
            <dl>
              {cuando && <div><dt>Cuándo</dt><dd>{cuando}</dd></div>}
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-caja">
          <p class="ficha-caja-titulo">¿Te apuntas con nosotros?</p>
          <p>Hazte socio y participa en esta y en el resto de actividades del club.</p>
          <a class="btn" href={unirse}>{textoUnirse}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="ficha-fotos" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras actividades" />
        <ul class="ficha-otras">
          {otras.map((o, i) => (
            <li class:list={['tarjeta ficha-otra border-t-[6px]', i % 2 ? 'border-t-acento' : 'border-t-primario']}>
              <span class:list={['ficha-otra-icono', i % 2 ? 'bg-acento/20 text-acento' : 'bg-primario/10 text-primario']}><Icono nombre={o.icono || 'montana'} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec ficha-todas" href={`/#${f.idSeccion}`}>Ver todas las actividades</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { background: color-mix(in srgb, var(--c-primario) 8%, var(--c-fondo)); border-bottom: 2px solid color-mix(in srgb, var(--c-primario) 12%, transparent); padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 6vw, 4.5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { color: var(--c-primario); text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .7; overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2rem; margin-top: clamp(.5rem, 2vw, 1.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.2rem, 6vw, 4rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .ficha-precio { font-family: var(--fuente-titulos); font-weight: 800; font-size: 1.2rem; color: var(--c-primario); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; padding: .7rem 1.4rem; }
  .ficha-foto { aspect-ratio: 4 / 3; border-radius: 1.1rem; overflow: hidden; border: 2px solid color-mix(in srgb, var(--c-primario) 18%, transparent); background: #fff; }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: 1.1rem; background: #fff; border: 2px solid color-mix(in srgb, var(--c-primario) 12%, transparent); border-top: 6px solid var(--c-acento); }
  .ficha-icono span { display: grid; place-items: center; width: 8rem; height: 8rem; border-radius: 50%; background: color-mix(in srgb, var(--c-primario) 10%, #fff); color: var(--c-primario); }
  .ficha-cuerpo { display: grid; gap: 2.5rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p:first-child { margin-top: 0; font-size: 1.2rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.25rem; color: var(--c-primario); margin-bottom: .75rem; }
  .ficha-datos { padding: 1.5rem; border-top: 6px solid var(--c-primario); }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .75rem 0; border-top: 1px solid color-mix(in srgb, var(--c-primario) 14%, transparent); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-caja { display: grid; gap: .9rem; border-radius: 1.1rem; padding: 1.75rem 1.5rem; background: var(--c-primario); color: #fff; border-top: 6px solid var(--c-acento); }
  .ficha-caja-titulo { font-family: var(--fuente-titulos); font-size: 1.5rem; font-weight: 800; line-height: 1.15; }
  .ficha-caja .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding: .7rem 1.4rem; }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 750; color: #fff; text-decoration: none; }
  .ficha-fotos { background: color-mix(in srgb, var(--c-acento) 10%, var(--c-fondo)); padding-block: clamp(2rem, 5vw, 3.5rem); }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; border-radius: 1.1rem; overflow: hidden; border: 2px solid #fff; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; overflow: hidden; }
  .ficha-otra-icono { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; }
  .ficha-otra h3 { font-size: 1.25rem; color: var(--c-primario); }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; overflow-wrap: anywhere; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 750; color: var(--c-primario); }
  .ficha-todas { display: inline-flex; align-items: center; min-height: 2.75rem; padding: .7rem 1.4rem; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 4.5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>