---
// Hero cercano: titular con palabra subrayada, botones de socio/actividades, collage de dos fotos y cifras en etiquetas.
import { seccion } from '../../data/site';
import { altGaleria, altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const destacado = (s?.titulo_destacado as string) || '';
const segunda = s?.galeria[0];
---

{
  s && (
    <section id={id} class="relative overflow-hidden bg-primario/[0.07]">
      <div class="contenedor grid items-center gap-12 py-12 md:grid-cols-2 md:py-20">
        <div>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          <h1 class="mt-3 text-[clamp(2.3rem,6.5vw,3.8rem)] text-primario">
            {`${s.titulo} `}{destacado && <span class="subrayado">{destacado}</span>}
          </h1>
          {s.texto && <p class="mt-5 max-w-lg text-lg opacity-85">{s.texto}</p>}
          <div class="mt-8 flex flex-wrap gap-3">
            {s.cta && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
            {s.cta_secundario && <a class="btn-sec" href={s.cta_secundario.url}>{s.cta_secundario.texto}</a>}
          </div>
          {s.items.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2">
              {s.items.map((it) => (
                <li class="chip">
                  <Icono nombre={it.icono} tam={16} />
                  <strong>{it.titulo}</strong> {it.texto}
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="relative pb-10 md:pb-0">
          <Imagen src={s.imagen} alt={altHero()} ancho={1200} alto={900} prioridad={primera} class="aspect-[4/3] w-[88%] rotate-[-2deg] rounded-[1.5rem] object-cover shadow-xl" />
          {segunda && (
            <Imagen src={segunda} alt={altGaleria(1)} ancho={800} alto={800} class="absolute -bottom-2 right-0 aspect-square w-[45%] rotate-[4deg] rounded-[1.25rem] border-4 border-fondo object-cover shadow-xl md:-bottom-10" />
          )}
        </div>
      </div>
    </section>
  )
}
