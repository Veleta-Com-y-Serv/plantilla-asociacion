---
// Junta directiva / voluntarios: fotos redondas con borde de color, centradas.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="grid grid-cols-2 gap-x-4 gap-y-10 text-center sm:grid-cols-3 lg:grid-cols-5">
        {s.personas.map((p, i) => (
          <li>
            <Imagen src={p.foto} alt={p.nombre} ancho={600} alto={720} class={'mx-auto aspect-square w-28 rounded-full border-4 object-cover md:w-32 ' + (i % 2 ? 'border-acento' : 'border-primario')} />
            <p class="mt-3 font-bold">{p.nombre}</p>
            {p.cargo && <p class="text-sm opacity-70">{p.cargo}</p>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
