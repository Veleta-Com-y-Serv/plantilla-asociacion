---
// Preguntas frecuentes: acordeón nativo <details> en tarjetas con franja de color alterna, sin JavaScript.
// Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta.
// También sirve de diseño para apartados nuevos (`tipo: preguntas`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <Seccion id={Astro.props.id} contenedor="max-w-3xl">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <div class="grid gap-4">
        {preguntas.map((p, i) => (
          <details class:list={['faq tarjeta border-l-[6px] px-5 md:px-6', i % 2 ? 'border-l-acento' : 'border-l-primario']} open={i === 0}>
            <summary class="flex items-center justify-between gap-4 py-5 text-lg font-bold text-primario">
              {p.pregunta}
              <span class:list={['faq-signo grid h-9 w-9 shrink-0 place-items-center rounded-full text-xl', i % 2 ? 'bg-acento/20 text-acento' : 'bg-primario/10 text-primario']} aria-hidden="true">+</span>
            </summary>
            {p.respuesta && <p class="pb-5 opacity-80">{p.respuesta}</p>}
          </details>
        ))}
      </div>
    </Seccion>
  )
}

<style>
  .faq summary { list-style: none; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq-signo { transition: transform 0.2s ease; }
  .faq[open] .faq-signo { transform: rotate(45deg); }
</style>
